# =====================================================================
#  AI EQUITY ANALYST  —  Environment configuration
#  Copy this file to ".env" and fill in your own values.
#  cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# Bodhi LLM Gateway — the ONE governed entry point every AI call in this
# app goes through (agents/base_agent.py, profile/profile_loader.py).
# No provider SDK (google-genai, openai, ...) is called directly anywhere
# in this codebase — see config.call_bodhi_llm().
# ---------------------------------------------------------------------
BODHI_LLM_GATEWAY_URL=https://bodhi-llm-gateway.sandbox.psbodhi.live
# Your Bodhi API token — paste exactly what goes after "Authorization: "
# in Bodhi's own docs (their example doesn't show a "Bearer " prefix, so
# don't add one unless your token value already includes it).
BODHI_LLM_GATEWAY_TOKEN=
# Your team's identifier, sent as the trace_user_id header (Bodhi's docs
# call this "ASPIRE TEAM NAME") — used for usage attribution on their side.
BODHI_LLM_TRACE_USER_ID=
# Any model ID from Bodhi's supported list (GET /v1/models) — e.g.
# gemini-2.5-pro, gpt-4.1, claude-4.5-sonnet.
BODHI_LLM_MODEL=gemini-2.5-pro

# ---------------------------------------------------------------------
# Run mode
# ---------------------------------------------------------------------
# How many high-conviction stocks the Decision Agent should return
TOP_N=3

# The stocks to scan each morning. Either:
#   NIFTY50  -> all Nifty 50 constituents (fetched live from NSE, cached)
#   NIFTY500 -> all Nifty 500 constituents (fetched live from NSE, cached)
#   or a comma-separated list of NSE symbols, e.g.
#   RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK
UNIVERSE=NIFTY50

# ---------------------------------------------------------------------
# Telegram alerts (OPTIONAL — leave blank to just print to screen)
# ---------------------------------------------------------------------
# 1. Create a bot with @BotFather on Telegram to get the token
# 2. Message your bot once, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------
# Investor profile (OPTIONAL)
# ---------------------------------------------------------------------
# Path to your profile file. Supports .txt .md .pdf .html .docx
# Leave blank to run without personalisation.
PROFILE_PATH=sample_profile.txt

# ---------------------------------------------------------------------
# LangSmith tracing (OPTIONAL — leave blank to disable, zero effect on the app)
# ---------------------------------------------------------------------
# Get a free key from https://smith.langchain.com -> Settings -> API Keys.
# When set, every real Gemini call and every pipeline step (swing run,
# intraday scan, backtest) is traced as one tree — see observability.py.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-equity-analyst

# ---------------------------------------------------------------------
# TradingView watchlist (OPTIONAL — leave blank/false to disable)
# ---------------------------------------------------------------------
# Pushes each run's shortlisted symbols into your real TradingView
# watchlist. LOCAL ONLY — no credentials, drives your already-logged-in
# TradingView Desktop app over Chrome DevTools Protocol on localhost.
# Requires TradingView Desktop to be running with the debug port enabled
# (see ~/mcp-servers/tradingview-mcp/scripts/launch_tv_debug_mac.sh)
# at the moment run.py executes — it's a live local connection, not a
# background service, so this is best-effort: if TradingView isn't open,
# it just logs a warning and the rest of the run continues normally.
TRADINGVIEW_WATCHLIST_ENABLED=false
TRADINGVIEW_CLI_PATH=~/mcp-servers/tradingview-mcp/src/cli/index.js

# ---------------------------------------------------------------------
# Bodhi Risk Insight (OPTIONAL — leave blank/false to disable)
# ---------------------------------------------------------------------
# Sends each run's real, deduped shortlist to a Bodhi workflow — two
# custom agents (Risk Analyst with live web research + a Contrarian
# red-team pass) — for an independent second opinion that gates the
# TradingView push. See integrations/bodhi_risk_insights.py. Best-effort:
# if unset or the call fails, run.py logs it and continues normally, same
# as TradingView above.
#
# BODHI_TASK_ID / BODHI_WORKFLOW_ID must point at YOUR own published
# workflow — find them in its Bodhi canvas URL (workflow ID) and its
# task's API/curl example (task ID).
BODHI_ENABLED=false
BODHI_BASE_URL=
BODHI_PAT_TOKEN=
BODHI_TASK_ID=
BODHI_WORKFLOW_ID=
# Your Bodhi workflow's entry-point variable names (Start Node / Workflow
# Variables — NOT a UI Node, which pauses for a human and breaks an
# API-triggered run). Bodhi variable names can't contain spaces; these
# defaults match a confirmed-working setup.
BODHI_PORTFOLIO_VARIABLE=Investmentportfolio
BODHI_QUERY_VARIABLE=Query_for_risk_assessment
# How the per-symbol loop is driven — both modes return identical results.
#   true  (default) one Bodhi run PER SYMBOL, driven from Python. Works with
#                   any single-stock workflow; one run id per decision.
#   false           ONE run for the whole shortlist, with the workflow's own
#                   Repeat node iterating it. Needs the expanded workflow in
#                   integrations/bodhi_workflow/ built and verified first.
BODHI_PER_SYMBOL_RUNS=true
BODHI_POLL_INTERVAL=5
BODHI_TIMEOUT=300
BODHI_TRACE_PREFIX=ai-equity-analyst
# Optional override — the risk question sent alongside the portfolio.
# BODHI_RISK_QUERY=
