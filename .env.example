# =====================================================================
#  AI EQUITY ANALYST  —  Environment configuration
#  Copy this file to ".env" and fill in your own values.
#  cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# Google ADK / Gemini settings
# ---------------------------------------------------------------------
# GOOGLE_AUTH_MODE decides HOW we log in to Gemini:
#   auto  = try Google ADC / Vertex AI first, then fall back to API key
#   adc   = use Google ADC / Vertex AI only  (recommended for Cloud)
#   token = use Google AI Studio API key only (easiest to start)
GOOGLE_AUTH_MODE=auto

# --- Vertex AI / ADC mode -------------------------------------------
# TRUE  -> route calls through Vertex AI (needs a Google Cloud project)
# FALSE -> route calls through Google AI Studio (needs an API key)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=burner-dikbhati1-01
GOOGLE_CLOUD_LOCATION=europe-west2

# --- Token / API-key fallback mode ----------------------------------
# Get a free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=replace-with-api-key-if-token-mode-is-used
# Optional custom bearer token if you route via your own gateway
GOOGLE_ACCESS_TOKEN=

# --- Model ----------------------------------------------------------
GOOGLE_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------------
# Run mode
# ---------------------------------------------------------------------
# DATA_MODE:
#   demo = use built-in sample market data (NO keys, NO internet needed)
#   live = fetch real prices from Yahoo Finance (needs internet)
DATA_MODE=demo

# How many high-conviction stocks the Decision Agent should return
TOP_N=3

# The stocks to scan each morning. Either:
#   NIFTY50  -> all Nifty 50 constituents (fetched live from NSE, cached)
#   NIFTY500 -> all Nifty 500 constituents (fetched live from NSE, cached)
#   or a comma-separated list of NSE symbols, e.g.
#   RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK
UNIVERSE=NIFTY50

# ---------------------------------------------------------------------
# Telegram alerts (OPTIONAL — leave blank to just print to screen)
# ---------------------------------------------------------------------
# 1. Create a bot with @BotFather on Telegram to get the token
# 2. Message your bot once, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------
# Investor profile (OPTIONAL)
# ---------------------------------------------------------------------
# Path to your profile file. Supports .txt .md .pdf .html .docx
# Leave blank to run without personalisation.
PROFILE_PATH=sample_profile.txt
