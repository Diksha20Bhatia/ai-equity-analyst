# =====================================================================
#  AI EQUITY ANALYST  —  Environment configuration
#  Copy this file to ".env" and fill in your own values.
#  cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# Bodhi LLM Gateway — the one AI entry point every agent call in this
# app goes through (config.call_llm()). No direct provider SDK
# (Gemini/OpenAI/Anthropic) is used anywhere in this codebase, and there
# is no alternate backend — this is the only model-calling path.
# See https://developer.psbodhi.live
# ---------------------------------------------------------------------
BODHI_LLM_GATEWAY_URL=https://bodhi-llm-gateway.sandbox.psbodhi.live
BODHI_LLM_GATEWAY_TOKEN=replace-with-your-bodhi-llm-gateway-token
# Bodhi calls this the "ASPIRE TEAM NAME" — sent as the trace_user_id header.
BODHI_LLM_TRACE_USER_ID=replace-with-your-team-name
# Any model id Bodhi's gateway currently exposes — check GET /v1/models.
BODHI_LLM_MODEL=gemini-2.5-pro
# Optional DELIBERATE per-agent model selection — a classification-shaped
# task (e.g. the Orchestrator's retry-or-finish routing) doesn't need the
# same model as one requiring real synthesis (the Decision Agent). Format:
# "Agent Name=model-id,Other Agent=model-id". Left commented (default):
# every agent uses BODHI_LLM_MODEL above — deliberately, not left off by
# accident. This one stays opt-in rather than shipping an active example
# like the budget above: unlike a token ceiling (a plain number, safe to
# guess high), a wrong model id here would hard-fail the very first call
# that agent makes, and the real model catalog is account-specific (`GET
# /v1/models` against YOUR OWN token — this repo's own token returned a
# real 403 "explicit deny in an identity-based policy" for that endpoint,
# so it isn't safe to ship a "confirmed" id here for every account).
# The mechanism itself is real and fully tested end to end regardless —
# see tests/test_config_gateway.py::test_per_agent_model_override_is_used_in_the_real_request
# (asserts the overridden model id lands in the real outgoing request body).
# BODHI_LLM_MODEL_OVERRIDES=Orchestrator=gemini-2.5-flash
# Optional cost governance, two tiers. Both ship ON below, not 0/disabled
# — a documented default that's actually active, not just available:
#   WARNING: logs a visible warning (never blocks) when a call's
#     REPORTED total_tokens crosses this, after it already succeeded.
#   LIMIT: an ENFORCED ceiling on the prompt's own ESTIMATED size,
#     refused BEFORE anything is sent to the gateway. Neither ever
#     triggers a fallback model — there is only one AI backend by design.
# Both numbers below are MEASURED, not guessed: the Decision Agent's
# batched 10-stock prompt (run.py caps watchlist_size at 10) is the
# single largest real prompt in this app, and every variable-length
# field in it is already capped at _CONTEXT_BUDGET_CHARS_PER_FIELD=500
# chars (agents/decision_agent.py) — so its true worst case is
# computable, not open-ended. Building that exact worst-case prompt
# (10 stocks, every optional field at its trimmed cap: retrieved KB
# notes, bull/bear case, key risk, research note, event summary, a
# persisted goal, profile constraints, retry feedback) through the real
# _build_prompt() and measuring it end to end gives ~59,700 real
# characters -> ~14,920 estimated tokens (chars ÷ 4, this app's own
# documented ratio). LIMIT is set with real headroom above that
# measured ceiling (~34%), not at it, so ordinary maximal-but-legitimate
# runs never trip it; WARNING sits below LIMIT as an earlier heads-up.
# Set either to 0 to disable, same as before.
BODHI_LLM_TOKEN_BUDGET_WARNING=12000
BODHI_LLM_TOKEN_BUDGET_LIMIT=20000
# ---------------------------------------------------------------------
# Run mode
# ---------------------------------------------------------------------
# How many high-conviction stocks the Decision Agent should return
TOP_N=3

# The stocks to scan each morning. Either:
#   NIFTY50  -> all Nifty 50 constituents (fetched live from NSE, cached)
#   NIFTY500 -> all Nifty 500 constituents (fetched live from NSE, cached)
#   or a comma-separated list of NSE symbols, e.g.
#   RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK
UNIVERSE=NIFTY50

# ---------------------------------------------------------------------
# Telegram alerts (OPTIONAL — leave blank to just print to screen)
# ---------------------------------------------------------------------
# 1. Create a bot with @BotFather on Telegram to get the token
# 2. Message your bot once, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------
# Investor profile (OPTIONAL)
# ---------------------------------------------------------------------
# Path to your profile file. Supports .txt .md .pdf .html .docx
# Leave blank to run without personalisation.
PROFILE_PATH=sample_profile.txt

# ---------------------------------------------------------------------
# LangSmith tracing (OPTIONAL — leave blank to disable, zero effect on the app)
# ---------------------------------------------------------------------
# Get a free key from https://smith.langchain.com -> Settings -> API Keys.
# When set, every real AI call and every pipeline step (swing run,
# intraday scan, backtest) is traced as one tree — see observability.py.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-equity-analyst

# ---------------------------------------------------------------------
# TradingView watchlist (OPTIONAL — leave blank/false to disable)
# ---------------------------------------------------------------------
# Pushes each run's shortlisted symbols into your real TradingView
# watchlist. LOCAL ONLY — no credentials, drives your already-logged-in
# TradingView Desktop app over Chrome DevTools Protocol on localhost.
# Requires TradingView Desktop to be running with the debug port enabled
# (see ~/mcp-servers/tradingview-mcp/scripts/launch_tv_debug_mac.sh)
# at the moment run.py executes — it's a live local connection, not a
# background service, so this is best-effort: if TradingView isn't open,
# it just logs a warning and the rest of the run continues normally.
TRADINGVIEW_WATCHLIST_ENABLED=false
TRADINGVIEW_CLI_PATH=~/mcp-servers/tradingview-mcp/src/cli/index.js

# A real TOOL CALL the Decision Agent makes itself, per stock, WHILE it's
# reasoning — a live TradingView quote pulled at that moment, shown to the
# LLM alongside its other data (see integrations/tradingview_quote.py).
# Different from the watchlist push above, which fires once, after a
# human approves, and isn't something an agent ever sees or reasons about.
# Same local connection/requirements as TRADINGVIEW_WATCHLIST_ENABLED.
TRADINGVIEW_QUOTE_ENABLED=false

# A SECOND, distinct agent tool call — TradingView's symbol-search REST
# endpoint (different transport: no Desktop CDP round-trip, <1s typical,
# vs ~20s for the live quote above). Confirms a shortlisted ticker
# actually resolves to a real NSE equity before the Decision Agent
# reasons about it. See integrations/tradingview_quote.py::verify_symbol().
TRADINGVIEW_SYMBOL_SEARCH_ENABLED=false

# A THIRD, independent symbol-verification path — a real local MCP
# server (integrations/mcp_server.py) reached over real stdio MCP
# transport (a different transport from both TradingView's calls above
# and Bodhi's own HTTP-based bodhi-deep-research tool), exposing all
# three MCP server primitives (Tools, Resources, Prompts). No external
# app dependency — unlike TradingView, this needs nothing open or
# running beyond Python itself. See integrations/mcp_pipeline_client.py.
MCP_VERIFICATION_ENABLED=false

# ---------------------------------------------------------------------
# Bodhi Risk Insight (OPTIONAL — leave blank/false to disable)
# ---------------------------------------------------------------------
# Sends each run's real, deduped shortlist to a Bodhi workflow — two
# custom agents (Risk Analyst with live web research + a Contrarian
# red-team pass) — for an independent second opinion that gates the
# TradingView push. See integrations/bodhi_risk_insights.py. Best-effort:
# if unset or the call fails, run.py logs it and continues normally, same
# as TradingView above.
#
# BODHI_TASK_ID / BODHI_WORKFLOW_ID must point at YOUR own published
# workflow — find them in its Bodhi canvas URL (workflow ID) and its
# task's API/curl example (task ID).
BODHI_ENABLED=false
BODHI_BASE_URL=
BODHI_PAT_TOKEN=
BODHI_TASK_ID=
BODHI_WORKFLOW_ID=
# Your Bodhi workflow's entry-point variable names (Start Node / Workflow
# Variables — NOT a UI Node, which pauses for a human and breaks an
# API-triggered run). Bodhi variable names can't contain spaces; these
# defaults match a confirmed-working setup.
BODHI_PORTFOLIO_VARIABLE=Investmentportfolio
BODHI_QUERY_VARIABLE=Query_for_risk_assessment
BODHI_POLL_INTERVAL=5
BODHI_TIMEOUT=300
BODHI_TRACE_PREFIX=ai-equity-analyst
# Optional override — the risk question sent alongside the portfolio.
# BODHI_RISK_QUERY=
